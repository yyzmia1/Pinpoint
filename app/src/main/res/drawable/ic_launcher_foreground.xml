        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="66"
                android:endY="74"
                android:startX="32"
                android:startY="29"
                android:type="linear">
                <item
                    android:color="#FFFFFFFF"
                    android:offset="0" />
                <item
                    android:color="#FFE2E8F0"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Document dog-ear fold -->
    <path
        android:fillColor="#CBD5E1"
        android:pathData="M58.5,29 L68,38.5 L60.5,38.5 A2,2 0 0,1 58.5,36.5 Z" />

