                    android:offset="0" />
                <item
                    android:color="#F0082F49"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Crisp sky-blue optical rim -->
    <path
        android:pathData="M60,46.5 A12.5,12.5 0 1,0 60,71.5 A12.5,12.5 0 1,0 60,46.5 Z"
        android:strokeColor="#38BDF8"
        android:strokeWidth="4.2" />

    <!-- Specular lens glint -->
    <path
        android:pathData="M53,56.5 A8,8 0 0,1 59.5,51"
        android:strokeAlpha="0.88"
