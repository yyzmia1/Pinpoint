    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft drop shadow under document sheet -->
    <path
        android:fillAlpha="0.24"
        android:fillColor="#020617"
        android:pathData="M37,32 L59,32 L68,41 L68,72 A5,5 0 0,1 63,77 L37,77 A5,5 0 0,1 32,72 L32,37 A5,5 0 0,1 37,32 Z" />

