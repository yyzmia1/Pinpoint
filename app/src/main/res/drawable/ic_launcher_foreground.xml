        android:fillColor="#38BDF8"
        android:pathData="M39,48 H50 A1.5,1.5 0 0,1 50,51 H39 A1.5,1.5 0 0,1 39,48 Z" />
    <path
        android:fillColor="#CBD5E1"
        android:pathData="M39,55 H45 A1.5,1.5 0 0,1 45,58 H39 A1.5,1.5 0 0,1 39,55 Z" />

    <!-- Subtle optical halo separating magnifier from document -->
    <path
        android:fillAlpha="0.32"
        android:fillColor="#0B1221"
        android:pathData="M61,44.5 A17,17 0 1,0 61,78.5 A17,17 0 1,0 61,44.5 Z" />

    <!-- Magnifier capsule handle -->
    <path
        android:pathData="M69.5,68.5 L77.5,76.5"
        android:strokeColor="#38BDF8"
        android:strokeLineCap="round"
        android:strokeWidth="6.2" />

    <!-- Glass lens body -->
    <path android:pathData="M60,46.5 A12.5,12.5 0 1,0 60,71.5 A12.5,12.5 0 1,0 60,46.5 Z">
